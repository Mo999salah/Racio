{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "APPLE_CLIENT_ID",
    "APPLE_TEAM_ID",
    "APPLE_KEY_ID",
    "APPLE_PRIVATE_KEY",
    "AI_ENABLED",
    "AI_PROVIDER",
    "AI_MODEL",
    "AI_API_KEY",
    "AI_BASE_URL",
    "AI_TIMEOUT_MS",
    "AI_MAX_INPUT_CHARS",
    "AI_MAX_OUTPUT_TOKENS",
    "AI_MAX_TOOL_CALLS",
    "AI_MAX_TRANSACTION_SAMPLES",
    "AI_MAX_RETRIES",
    "AI_RATE_LIMIT_WINDOW_MS",
    "AI_RATE_LIMIT_MAX",
    "EXPORT_SYNC_MAX_ROWS",
    "EXPORT_MAX_ROWS",
    "EXPORT_MAX_FILE_BYTES",
    "EXPORT_MAX_ARCHIVE_RECORDS",
    "EXPORT_RETENTION_HOURS",
    "EXPORT_MAX_CONCURRENT_PER_USER",
    "RACIO_RUN_DB_INTEGRATION",
    "RACIO_RUN_PARSER_INTEGRATION",
    "PARSER_URL",
    "LOCAL_STORAGE_PATH",
    "PG_BOSS_SCHEMA",
    "IMPORT_ORPHAN_RETENTION_HOURS",
    "RACIO_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
