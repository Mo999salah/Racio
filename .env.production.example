# Racio production environment example

Copy to `.env.production` and fill in real values. NEVER commit this file.
Secrets must come from a secrets manager or the deployment platform; do not
paste real values here.

Legend:
- [REQUIRED] must be set for production
- [OPTIONAL] safe to leave unset
- [SECRET] never expose to clients or logs
- [DEPLOYMENT] value depends on your deployment

## Core

NODE_ENV=production                          # [REQUIRED] must be exactly production
DATABASE_URL=postgresql://racio:CHANGE_ME@db-host:5432/racio   # [REQUIRED] [SECRET]
BETTER_AUTH_URL=https://racio.example.com   # [REQUIRED] public https origin; http rejected in production
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_FRESH_RANDOM_VALUE_32_PLUS  # [REQUIRED] [SECRET] generate with: openssl rand -base64 48
RACIO_VERSION=0.1.0                          # [OPTIONAL] version surfaced by health endpoints

## PostgreSQL (compose deployment)

POSTGRES_DB=racio                            # [REQUIRED] [DEPLOYMENT]
POSTGRES_USER=racio                          # [REQUIRED] [DEPLOYMENT]
POSTGRES_PASSWORD=CHANGE_ME                  # [REQUIRED] [SECRET]

## OAuth (optional; a provider appears only when fully configured)

# GOOGLE_CLIENT_ID=                          # [OPTIONAL] [DEPLOYMENT]
# GOOGLE_CLIENT_SECRET=                      # [OPTIONAL] [SECRET]
# APPLE_CLIENT_ID=                           # [OPTIONAL] [DEPLOYMENT]
# APPLE_TEAM_ID=                             # [OPTIONAL] [DEPLOYMENT]
# APPLE_KEY_ID=                              # [OPTIONAL] [DEPLOYMENT]
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----  # [OPTIONAL] [SECRET]

## Services

PARSER_URL=http://parser:8001                # [REQUIRED] internal parser endpoint
STORAGE_DRIVER=local                         # [OPTIONAL] local only in the MVP
LOCAL_STORAGE_PATH=/var/lib/racio/uploads    # [REQUIRED] [DEPLOYMENT] private persistent volume
PG_BOSS_SCHEMA=pgboss                        # [OPTIONAL]
PARSER_TIMEOUT_MS=30000                      # [OPTIONAL]
IMPORT_ORPHAN_RETENTION_HOURS=24             # [OPTIONAL]
WORKER_HEALTH_PORT=3101                      # [OPTIONAL] [DEPLOYMENT]

## AI advisor (strictly optional; disabled by default)

AI_ENABLED=false                             # [OPTIONAL] default false
# AI_PROVIDER=openai-compatible              # [OPTIONAL]
# AI_MODEL=gpt-4o-mini                       # [OPTIONAL] [DEPLOYMENT]
# AI_API_KEY=                                # [OPTIONAL] [SECRET] required only when AI_ENABLED=true
# AI_BASE_URL=https://api.openai.com/v1      # [OPTIONAL] [DEPLOYMENT]
# AI_TIMEOUT_MS=30000
# AI_MAX_INPUT_CHARS=2000
# AI_MAX_OUTPUT_TOKENS=500
# AI_MAX_TOOL_CALLS=4
# AI_MAX_TRANSACTION_SAMPLES=20
# AI_MAX_RETRIES=1
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=20

## Upload and parser limits (bounded by design; do not raise beyond the documented maxima)

MAX_UPLOAD_BYTES=20971520                    # [OPTIONAL] 20 MiB
MAX_XLSX_ARCHIVE_BYTES=20971520              # [OPTIONAL]
MAX_XLSX_UNCOMPRESSED_BYTES=104857600        # [OPTIONAL]
MAX_XLSX_COMPRESSION_RATIO=100               # [OPTIONAL]
MAX_XLSX_ZIP_ENTRIES=2048                    # [OPTIONAL]
MAX_XLSX_SHEETS=32                           # [OPTIONAL]
MAX_XLSX_ROWS=100000                         # [OPTIONAL]
MAX_XLSX_COLUMNS=256                         # [OPTIONAL]
MAX_XLSX_POPULATED_CELLS=500000              # [OPTIONAL]
MAX_XLSX_SHARED_STRINGS=250000               # [OPTIONAL]
MAX_XLSX_CELL_STRING_LENGTH=20000            # [OPTIONAL]
MAX_XLSX_FORMULAS=10000                      # [OPTIONAL]
MAX_XLSX_MERGED_RANGES=2000                  # [OPTIONAL]
MAX_PDF_UPLOAD_BYTES=20971520                # [OPTIONAL] 20 MiB
MAX_PDF_PAGES=200                            # [OPTIONAL]
MAX_PDF_PAGE_DIMENSION_POINTS=14400          # [OPTIONAL]
MAX_PDF_CHARS_PER_PAGE=200000                # [OPTIONAL]
MAX_PDF_TOTAL_CHARS=2000000                  # [OPTIONAL]
MAX_PDF_WORDS_PER_PAGE=40000                 # [OPTIONAL]
MAX_PDF_CANDIDATES=50000                     # [OPTIONAL]
MAX_PDF_STREAM_BYTES=41943040                # [OPTIONAL]
MAX_PDF_OBJECTS=100000                       # [OPTIONAL]

## Exports (files are private and expire)

EXPORT_SYNC_MAX_ROWS=10000                   # [OPTIONAL]
EXPORT_MAX_ROWS=250000                       # [OPTIONAL]
EXPORT_MAX_FILE_BYTES=52428800               # [OPTIONAL] 50 MiB
EXPORT_MAX_ARCHIVE_RECORDS=100000            # [OPTIONAL]
EXPORT_RETENTION_HOURS=24                    # [OPTIONAL] file expiry
EXPORT_MAX_CONCURRENT_PER_USER=3             # [OPTIONAL]

## Deployment-specific

WEB_PORT=3000                                # [OPTIONAL] [DEPLOYMENT] host port for the web service
