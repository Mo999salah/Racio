NODE_ENV=development
DATABASE_URL=postgresql://racio:racio_dev@localhost:5432/racio
BETTER_AUTH_SECRET=racio-local-development-secret-change-me-32
BETTER_AUTH_URL=http://localhost:3000
# Optional OAuth providers. Leave an entire provider unset to hide it from the UI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
PARSER_URL=http://localhost:8001
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads
PG_BOSS_SCHEMA=pgboss
NEXT_PUBLIC_DEFAULT_LOCALE=en
MAX_XLSX_ARCHIVE_BYTES=20971520
MAX_XLSX_UNCOMPRESSED_BYTES=104857600
MAX_XLSX_COMPRESSION_RATIO=100
MAX_XLSX_ZIP_ENTRIES=2048
MAX_XLSX_SHEETS=32
MAX_XLSX_ROWS=100000
MAX_XLSX_COLUMNS=256
MAX_XLSX_POPULATED_CELLS=500000
MAX_XLSX_SHARED_STRINGS=250000
MAX_XLSX_CELL_STRING_LENGTH=20000
MAX_XLSX_FORMULAS=10000
MAX_XLSX_MERGED_RANGES=2000
MAX_PDF_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
MAX_PDF_PAGE_DIMENSION_POINTS=14400
MAX_PDF_CHARS_PER_PAGE=200000
MAX_PDF_TOTAL_CHARS=2000000
MAX_PDF_WORDS_PER_PAGE=40000
MAX_PDF_CANDIDATES=50000
PARSER_TIMEOUT_MS=30000
# Optional AI advisor. The advisor is strictly optional: Racio works fully when
# AI is disabled. Leave these unset to run with the advisor unavailable.
# AI_ENABLED=false
# AI_PROVIDER=openai-compatible
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=30000
# AI_MAX_INPUT_CHARS=2000
# AI_MAX_OUTPUT_TOKENS=500
# AI_MAX_TOOL_CALLS=4
# AI_MAX_TRANSACTION_SAMPLES=20
# AI_MAX_RETRIES=1
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=20
# Phase 12 export limits. Generated files are private and expire.
EXPORT_SYNC_MAX_ROWS=10000
EXPORT_MAX_ROWS=250000
EXPORT_MAX_FILE_BYTES=52428800
EXPORT_MAX_ARCHIVE_RECORDS=100000
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_CONCURRENT_PER_USER=3
